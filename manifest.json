{
  "manifest_version": 3,
  "name": "SubsAnywhere",
  "version": "0.4.1",
  "description": "Находит две дорожки субтитров, синхронизирует их и показывает одновременно.",
  "permissions": ["activeTab", "scripting", "storage", "unlimitedStorage"],
  "host_permissions": [
    "https://subdl.com/*",
    "https://api3.subdl.com/*",
    "https://dl.subdl.com/*",
    "https://api.deepseek.com/*"
  ],
  "optional_host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js", "type": "module" },
  "action": {
    "default_title": "SubsAnywhere",
    "default_popup": "popup.html"
  }
}
