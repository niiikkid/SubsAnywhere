{
  "manifest_version": 3,
  "name": "SubsAnywhere",
  "version": "0.9.0",
  "minimum_chrome_version": "120",
  "description": "Показывает оригинальные и локальные субтитры и переводит целые реплики и отдельные фразы через DeepSeek.",
  "permissions": ["activeTab", "scripting", "storage", "unlimitedStorage"],
  "host_permissions": ["https://api.deepseek.com/*", "http://127.0.0.1:43817/*"],
  "optional_host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js", "type": "module" },
  "action": {
    "default_title": "SubsAnywhere",
    "default_popup": "popup.html"
  }
}
