{
  "manifest_version": 3,
  "name": "SubsAnywhere",
  "version": "0.10.0",
  "minimum_chrome_version": "120",
  "description": "Показывает оригинальные и локальные субтитры и переводит целые реплики и отдельные фразы через DeepSeek или OpenAI.",
  "permissions": ["activeTab", "scripting", "storage", "unlimitedStorage"],
  "host_permissions": ["https://api.deepseek.com/*", "https://api.openai.com/*", "http://127.0.0.1:43817/*"],
  "optional_host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js", "type": "module" },
  "content_scripts": [{
    "matches": ["http://127.0.0.1:43817/*"],
    "js": ["words-bridge.js"],
    "run_at": "document_start"
  }, {
    "matches": ["http://*/*", "https://*/*"],
    "js": ["panel-layout.js", "panel-host.js"],
    "run_at": "document_idle"
  }],
  "web_accessible_resources": [{
    "resources": ["popup.html"],
    "matches": ["<all_urls>"]
  }],
  "action": {
    "default_title": "Показать или скрыть SubsAnywhere"
  }
}
