{
  "manifest_version": 3,
  "name": "SubsAnywhere",
  "version": "0.3.0",
  "description": "Показывает две встроенные или добавленные SRT-дорожки с ручной синхронизацией.",
  "permissions": ["activeTab", "scripting", "storage", "unlimitedStorage"],
  "optional_host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js", "type": "module" },
  "action": {
    "default_title": "SubsAnywhere",
    "default_popup": "popup.html"
  }
}
